diff --git a/pexpert/pexpert/arm64/BLUEJAY.h b/pexpert/pexpert/arm64/BLUEJAY.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/BLUEJAY.h
@@ -0,0 +1,8 @@
+/* Pixel 6a / GS101: generic ARMv8.2, 16K pages, GICv3 and PSCI. */
+#ifndef _PEXPERT_ARM64_BLUEJAY_H
+#define _PEXPERT_ARM64_BLUEJAY_H
+#include <pexpert/arm64/SWEET.h>
+#define BLUEJAY_FB_BASE 0xfac00000
+#define BLUEJAY_FB_BLOCK 0xfa000000
+#define BLUEJAY_FB_OFFSET 0x00c00000
+#endif
